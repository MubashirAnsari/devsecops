<!-- github_webhook_receiver_rules.xml - health of the webhook receiver itself
     Alerts on the receiver Lambda's own log lines, pulled by the
     aws-s3 wodle <service type="cloudwatchlogs"> for /aws/lambda/YOUR_FUNCTION_NAME.
     Lambda prints one JSON object per line, e.g.
       {"result": "rejected", "reason": "ip_not_allowed", "source_ip": "x.x.x.x"}
     Matching is on decoded fields only (never text), anchored on result + reason.
     Lambda Errors / Throttles are covered by CloudWatch alarms (no log line for throttles). -->
<group name="github,github_webhook,github_receiver,">

  <rule id="100716" level="5">
    <decoded_as>json</decoded_as>
    <field name="result">^rejected$</field>
    <field name="reason">^ip_not_allowed$</field>
    <description>GitHub webhook receiver: request from $(source_ip) rejected (not a GitHub hook IP)</description>
  </rule>

  <rule id="100717" level="10">
    <decoded_as>json</decoded_as>
    <field name="result">^rejected$</field>
    <field name="reason">^bad_signature$</field>
    <description>GitHub webhook receiver: invalid HMAC signature from GitHub IP $(source_ip) - delivery dropped (secret mismatch or forged request)</description>
  </rule>

  <rule id="100718" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100716</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>GitHub webhook receiver: repeated rejected requests (5 in 10 min) from $(source_ip)</description>
  </rule>

  <rule id="100719" level="12" frequency="3" timeframe="600">
    <if_matched_sid>100717</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>GitHub webhook receiver: repeated invalid signatures (3 in 10 min) from $(source_ip)</description>
  </rule>

  <rule id="100720" level="12">
    <decoded_as>json</decoded_as>
    <field name="result">^rejected$</field>
    <field name="reason">^allowlist_unavailable$</field>
    <description>GitHub webhook receiver FAILING CLOSED: GitHub IP list unavailable, deliveries rejected with 503</description>
  </rule>

  <rule id="100721" level="7">
    <decoded_as>json</decoded_as>
    <field name="result">^meta_refresh_failed$</field>
    <description>GitHub webhook receiver: could not refresh GitHub hook IP ranges (using cached list)</description>
  </rule>

</group>
